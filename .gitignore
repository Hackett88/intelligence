# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docker & infra
docker-compose*.yml
docker-data/

# drizzle：纳入手写 .sql 迁移（建库/部署的权威指令集），忽略过时的 kit 快照（meta/ 早停在 0002）
drizzle/meta/

# temp & logs
temp/
*.log

# 浏览器实测截图等本地验证产物（体量大、非源码，留本地即可）
test-evidence/

# local debug artifacts (root-level screenshots / scratch folders)
/*.png
.screens/
.claude/
.tmp/
.tmp-screens/
# agent 取证截图（过程物料，不入代码仓库）
/ga4-screenshots/
/截图/
/验证截图/
